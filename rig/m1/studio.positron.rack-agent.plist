<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  studio.positron.rack-agent — keeps the studio Mac in its relay room.

  🔴 A LaunchAGENT, NOT A LaunchDaemon, AND THAT IS NOT A STYLE CHOICE. The
  audio tap needs a TCC grant, and TCC grants belong to a LOGGED-IN GUI session
  — a daemon has none, so the tap would come back "refused" and emit correctly-
  clocked SILENCE, which every layer above reports as success. Live has to be
  running anyway, and Live is a GUI app, so there is nothing a daemon buys.

  ⚠️ THE FULL PATH TO node IS NOT PEDANTRY. launchd starts with a minimal PATH,
  the same one a non-interactive ssh gets — and `node` is not on it, on a
  machine where `which node` in a login shell answers straight away. That cost
  one start here.

  Install:  cp rig/m1/studio.positron.rack-agent.plist ~/Library/LaunchAgents/
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/studio.positron.rack-agent.plist
  Stop:     launchctl bootout gui/$(id -u)/studio.positron.rack-agent
  Watch:    tail -f /tmp/rack-agent.log
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>studio.positron.rack-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/kristjanjansen/positron-rack/live-agent.mjs</string>
    <string>--room</string>
    <string>m1-1</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/kristjanjansen/positron-rack</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- Without this a crash loop restarts flat out and takes the room's socket
       budget with it: the relay allows 16 to a room and does not say no, it
       just drops. -->
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/tmp/rack-agent.log</string>
  <key>StandardErrorPath</key><string>/tmp/rack-agent.log</string>
</dict>
</plist>
