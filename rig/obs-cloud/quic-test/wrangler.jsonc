{
  "name": "elektron-obscloud-quic",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "QuicTest",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "QUIC_TEST", "class_name": "QuicTest" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuicTest"] }]
}
