{
	// positron-station: since 2026-10-02 only GET /media/ on its bucket; the station moved to eccm
	// (see worker.mjs). Before that: the schedule, as one continuous HLS source.
	//
	// ITS OWN WORKER AND ITS OWN BUCKET. `workers/vain` holds one broadcaster's
	// archive and a write path with per-session quotas; this one holds the
	// running order of a station and must be readable by anybody with a phone.
	// They will share objects eventually and they do not share a failure
	// surface: a station that cannot compute its playlist must not be able to
	// stop an upload finishing, and an upload must not be able to stop the
	// station playing.
	//
	// 🔴 NOT `elektron-archive-test`, for the reason `workers/vain` gives: two
	// workers already share that bucket and one of them runs a cron that deletes
	// every object under a prefix in it.
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "positron-station",
	"main": "worker.mjs",
	"compatibility_date": "2026-09-01",
	"workers_dev": true,
	// 🔴 R2, NOT WORKERS STATIC ASSETS. MEASURED 2026-09-15 17:50Z: a
	// `Range: bytes=461-1460` against an asset directory answered 200 with the
	// whole 4 801 140-byte file and no `accept-ranges`, from outside and from
	// the ASSETS binding alike. No Range means no `#EXT-X-BYTERANGE`, which is
	// the entire design. R2 answers 206.
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "positron-station" }
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Schedule"] },
		{ "tag": "v2", "new_sqlite_classes": ["Library"] },
		// 2026-10-02: the station moved to eccm, and its two objects with their running orders and records
		// went with it (copied first, compared on all three channels), so they are deleted here
		{ "tag": "v3", "deleted_classes": ["Schedule", "Library"] }
	],
	// 2026-10-08: the */5 cron outlived the scheduled handler and threw on every run.
	// wrangler leaves an existing cron alone unless this says empty, so it says empty.
	"triggers": { "crons": [] },
	"observability": { "enabled": true }
}
