{
  // elektron-view — the demo sequence on one phone-openable
  // URL: a menu at / plus four pages under /proto/*.
  //
  // public/ is ASSEMBLED BY build.mjs from an explicit allowlist, never from a
  // directory glob — the repo root holds .env and an assets directory is
  // uploaded publicly and verbatim. Run `node build.mjs` before every deploy.
  //
  // Static assets serve every page, every module and every committed cache
  // entry straight from the edge. src/index.js runs only for paths with no
  // asset behind them (/err-img, /icy/*, /report, /notes/<slug>, redirects),
  // see DEPLOYED.md.
  "name": "elektron-view",
  // Public hostname(s) on positron.studio (Cloudflare Registrar zone, added
  // 2026-09-04). workers_dev stays TRUE on purpose: the .workers.dev name keeps
  // serving, so the move is additive and every old link still resolves.
  "routes": [{ "pattern": "positron.studio", "custom_domain": true }, { "pattern": "www.positron.studio", "custom_domain": true }],
  "workers_dev": true,
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    // the Worker reads committed cache entries back out of the asset store
    "binding": "ASSETS",
    // unmatched paths fall through to the Worker (which 404s) rather than
    // being answered with an SPA index.html
    "not_found_handling": "none"
  },
  // The `Gate` Durable Object (the ERR search proxy's global rate gate and
  // durable 2-day cache) was removed 2026-10-14 with /api/search, /api/item and
  // /api/stats. v2 DELETES the class and, with it, every row it stored. Both
  // tags stay: migrations are applied in order and v1 is already applied.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Gate"] },
    { "tag": "v2", "deleted_classes": ["Gate"] }
  ],
  "observability": { "enabled": true }
}
