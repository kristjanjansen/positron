{
  "name": "positron-pub",
  // pub.positron.studio — the ffmpeg publisher for the Act 1 demos, alive
  // exactly as long as somebody holds /watch.
  //
  // instance_type "standard", not the obs-cloud rig's "standard-4": that image
  // exists to compose SCENES (OBS + browser source + llvmpipe fixes, ~190% of a
  // core, 11.6 s cold wake). A test pattern with a burned-in epoch pushed at
  // Stream is ffmpeg's job at a quarter of the instance.
  "routes": [{ "pattern": "pub.positron.studio", "custom_domain": true }],
  "workers_dev": true,
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "containers": [
    {
      "class_name": "Pub",
      "image": "./container/Dockerfile",
      // THREE: the test pattern instance (`p1`), /stage/'s film (`stage`) and
      // /cam/'s camera rewrap (`cam`), each on its own input.
      "max_instances": 3,
      // CUSTOM, not a predefined type, because the predefined ones are wrong in
      // both directions here.
      //
      // "standard" is an alias for standard-1 = HALF a vCPU, which is what
      // stalled the stream: two x264 encodes on half a core ran at ~40 % of
      // realtime and Cloudflare starved (the container logged lags of 59 s and
      // 83 s). And its 4 GiB is 8x more memory than needed — two 360p encodes
      // completed inside a 512 MiB cap.
      //
      // MEMORY AND VCPU ARE COUPLED: the platform refuses less than 3 GiB per
      // vCPU ("With 2 vCPU(s), you need at least 6 GiB of memory"), so asking
      // for 2 vCPU / 1 GiB is rejected even though two 360p encodes fit in
      // 512 MiB. 3 GiB here is the FLOOR for 1 vCPU, not a request.
      //
      // Given that, the economics: CPU bills on ACTIVE USAGE, so two encodes
      // cost the same vCPU-seconds however they are split — parallel instances
      // would just pay memory and disk TWICE for the same CPU. What is left to
      // save is the over-provisioning: this is 1 vCPU (double standard-1's half)
      // with 3 GiB instead of standard-2's 6 GiB and 2 GB of disk instead of
      // 12 GB. Same CPU as standard-2, half the memory, a sixth of the disk.
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 2048 }
    },
    {
      // THE SAME IMAGE ON THE NEW RUNTIME (research/cf-containers-next-2026-10-07.md).
      // A second application because `scheduling_policy` "Cannot be changed
      // after the application is created", so `Pub` above cannot be switched.
      // This policy refuses `image`, `instance_type` and `max_instances`: the
      // size above travels in code (NEXT_INSTANCE in worker.mjs), and the cap
      // of three is the entry worker's three instance names.
      "class_name": "PubNext",
      "scheduling_policy": "durable_object",
      "images": { "pub": { "dockerfile": "./container/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PUB", "class_name": "Pub" },
      { "name": "PUB_NEXT", "class_name": "PubNext" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pub"] },
    { "tag": "v2", "new_sqlite_classes": ["PubNext"] }
  ],
  "vars": {
    // Both legs encode at once on ONE instance, so this is the real budget.
    // Tunable without rebuilding the image, which is how the stall got
    // diagnosed: half a vCPU could not hold two 720p30 encodes.
    "PUB_W": "1280", "PUB_H": "720", "PUB_FPS": "30",
    // TESTSRC2, NOT THE FILM. `testsrc2` (or empty) means testsrc2 in
    // container/server.mjs; the word, because an empty env value was never
    // measured surviving the container runtime.
    // The live stream has shown testsrc2 since 2026-09-25 because the film
    // commit was never deployed, and /moq/ is about to be matched 1:1 against
    // this picture, so the deploy that ships the new clock layout must not
    // also swap the picture underneath it.
    "PUB_SOURCE": "testsrc2",
    // THE BURNED CLOCKS ON. server.mjs defaults them OFF since the film
    // commit, so without this the same deploy would ship testsrc2 with no
    // ABSOLUTE and no LOCAL at all. Both reach the container through
    // `envVars` in worker.mjs; a var here is not in the container's env alone.
    "PUB_BURN": "1",
    // WHICH CLASS ANSWERS: "legacy" is `Pub`, "next" is `PubNext`. `?rt=` on
    // any request overrides it, which is how the new one was driven live
    // before anybody's viewers were moved.
    "PUB_RT": "legacy"
  },
  "observability": { "enabled": true }
}
