{
	// elektron-selfrec — PROTO A ingest worker: participant-side MediaRecorder
	// chunks stream straight into R2 (bucket elektron-archive-test, prefix
	// selfrec/). Auth = Bearer SELFREC_TOKEN (worker secret, never in code).
	// Does NOT touch elektron-rtc (workers/rtc) in any way.
	"name": "elektron-selfrec",
	// Public hostname(s) on positron.studio (Cloudflare Registrar zone, added
	// 2026-09-04). workers_dev stays TRUE on purpose: the .workers.dev name keeps
	// serving, so the move is additive and every old link still resolves.
	"routes": [{ "pattern": "selfrec.positron.studio", "custom_domain": true }],
	"workers_dev": true,
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",
	"r2_buckets": [
		{ "binding": "ARCHIVE", "bucket_name": "elektron-archive-test" }
	],
	"observability": { "enabled": true }
}
