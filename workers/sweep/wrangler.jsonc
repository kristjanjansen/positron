{
	// positron-sweep: deletes Stream recordings of the test inputs once they
	// are a day old. See worker.mjs for why and what.
	//
	// Secrets (wrangler secret put): ACCOUNT_ID; STREAM_TOKEN, an API token
	// with Stream edit on this account; SWEEP_TOKEN, the bearer for POST /sweep.
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "positron-sweep",
	"main": "worker.mjs",
	"compatibility_date": "2026-09-01",
	"workers_dev": true,
	"vars": {
		// The two RTMPS rig inputs low-latency-demo and latency-rig-llhls, which
		// record (`mode: automatic`). By uid, never by name. positron-demo and
		// positron-cam were here until 2026-10-13, when both inputs were deleted
		// from Stream (with whep-rig). Not positron-stage or positron-cam-whip:
		// recording is off on both (read 2026-10-08). Not positron-hls-loopback,
		// which pub's own cron sweeps. Not `Maria`, which is not positron's.
		"INPUTS": "5cfa5053fffe478fffbb9b5c65773d34,4c93bc4b4809c29b03cc60fd8add29df",
		"MAX_AGE_H": "24"
	},
	"triggers": { "crons": ["41 * * * *"] },
	"observability": { "enabled": true }
}
