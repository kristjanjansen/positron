{
  "title": "positron demo score — phase 3c cue-driven choreography",
  "version": 1,
  "room": "score-show",
  "durationMs": 300000,
  "comment": [
    "A score is a timed cue list an operator console executes against the room.",
    "Two action channels (see NOTES.md P3C semantics decision):",
    "  promote/demote -> direct operator frames (roster state, DO-validated),",
    "  cue            -> {type:'cue'} passthrough (view choreography: rotate/setLivePage/note).",
    "fireAt = ms offset from show t0. setup fires immediately when the operator joins",
    "(the base cast); the operator re-fires the expected tier for any participant that",
    "rejoins mid-show. Actions in one event fire back-to-back (one dramaturgical beat)."
  ],
  "setup": [
    { "action": "promote", "participantId": "1", "tier": "featured" },
    { "action": "promote", "participantId": "2", "tier": "featured" },
    { "action": "promote", "participantId": "A", "tier": "live" },
    { "action": "promote", "participantId": "B", "tier": "live" },
    { "action": "promote", "participantId": "C", "tier": "live" },
    { "action": "promote", "participantId": "D", "tier": "live" },
    { "action": "promote", "participantId": "E", "tier": "live" },
    { "action": "promote", "participantId": "F", "tier": "live" }
  ],
  "events": [
    { "id": "e01-spotlight-W", "fireAt": 10000, "label": "spotlight from the crowd (wall->featured)",
      "actions": [ { "action": "promote", "participantId": "W", "tier": "featured" } ] },
    { "id": "e02-rotate", "fireAt": 30000, "label": "advance the live page",
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e03-swap-spotlight", "fireAt": 45000, "label": "demote W, spotlight Y",
      "actions": [ { "action": "demote", "participantId": "W", "tier": "wall" },
                   { "action": "promote", "participantId": "Y", "tier": "featured" } ] },
    { "id": "e04-wave1-1", "fireAt": 60000, "label": "grid wave: full crowd sweep",
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e05-wave1-2", "fireAt": 70000,
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e06-wave1-3", "fireAt": 80000,
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e07-wave1-4", "fireAt": 90000,
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e08-wave1-5", "fireAt": 100000,
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e09-wave1-6", "fireAt": 110000,
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e10-duet", "fireAt": 120000, "label": "duet: two from the live tier join the stage",
      "actions": [ { "action": "demote", "participantId": "Y", "tier": "wall" },
                   { "action": "promote", "participantId": "A", "tier": "featured" },
                   { "action": "promote", "participantId": "C", "tier": "featured" } ] },
    { "id": "e11-solo", "fireAt": 150000, "label": "back to solo",
      "actions": [ { "action": "demote", "participantId": "C", "tier": "live" } ] },
    { "id": "e12-reset", "fireAt": 180000, "label": "stage back to the two performers",
      "actions": [ { "action": "demote", "participantId": "A", "tier": "live" } ] },
    { "id": "e13-wave2-1", "fireAt": 190000, "label": "second sweep",
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e14-wave2-2", "fireAt": 200000,
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e15-wave2-3", "fireAt": 210000,
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e16-wave2-4", "fireAt": 220000,
      "actions": [ { "action": "cue", "cue": { "cmd": "rotate" } } ] },
    { "id": "e17-spotlight-X", "fireAt": 240000, "label": "final bow from the crowd",
      "actions": [ { "action": "promote", "participantId": "X", "tier": "featured" } ] },
    { "id": "e18-farewell", "fireAt": 270000,
      "actions": [ { "action": "demote", "participantId": "X", "tier": "wall" } ] },
    { "id": "e19-curtain", "fireAt": 285000, "label": "pure cue: propagation only, no visual",
      "actions": [ { "action": "cue", "cue": { "cmd": "note", "text": "curtain" } } ] }
  ]
}
